[Unit]
Description=Taxonomaid pattern miner (one-shot)
After=taxonomaid.service

[Service]
Type=oneshot

# Same credential plumbing as taxonomaid.service - keeps secrets out
# of /proc/<pid>/environ and limits readability to this service's
# private tmpfs. See taxonomaid.service for the full rationale.
LoadCredential=gemini_api_key:%h/.config/taxonomaid/secrets/gemini_api_key
Environment=GEMINI_API_KEY_FILE=%d/gemini_api_key

ExecStart=%h/.local/bin/taxonomaid mine --config-dir %h/.config/taxonomaid --data-dir %h/.local/share/taxonomaid/data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/taxonomaid %h/.local/share/taxonomaid
